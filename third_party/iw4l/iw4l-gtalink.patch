new file mode 100644
index 0000000..d262b1d
--- /dev/null
+++ b/crates/console/src/gtalink.rs
@@ -0,0 +1,112 @@
+//! GTA link input: GTA's keyboard and mouse (sampled by PipeLink, `common/mw2link.h`) become the
+//! same scripted inputs the console verbs `hold` / `release` / `mousemove` use, and GTA's console
+//! lines (give, spawn, ...) join the console queue.
+
+use bevy::prelude::*;
+use frame::gtalink::{self, InputSnapshot, button};
+
+use crate::{ConsoleInputState, ConsoleQueue};
+
+#[derive(Default)]
+pub(crate) struct GtaLinkInput {
+    last: Option<InputSnapshot>,
+    cmd_read: Option<u32>,
+}
+
+const HOLDS: [(u32, &str); 9] = [
+    (button::ATTACK, "+attack"),
+    (button::ADS, "+speed_throw"),
+    (button::RELOAD, "+usereload"),
+    (button::SPRINT, "+breath_sprint"),
+    (button::MELEE, "+melee"),
+    (button::JUMP, "+gostand"),
+    (button::FRAG, "+frag"),
+    (button::SMOKE, "+smoke"),
+    (button::HOLDBREATH, "+holdbreath"),
+];
+
+const EDGES: [(u32, &str); 4] = [
+    (button::CROUCH, "togglecrouch"),
+    (button::PRONE, "toggleprone"),
+    (button::WEAPNEXT, "weapnext"),
+    (button::USE, "+activate"),
+];
+
+pub(crate) fn feed_gta_input(
+    mut state: Local<GtaLinkInput>,
+    mut scripted: ResMut<ConsoleInputState>,
+    mut queue: ResMut<ConsoleQueue>,
+    mut devices: ResMut<frame::InputDevices>,
+    screen: Option<Res<frame::AppScreen>>,
+) {
+    let Some(input) = gtalink::read_input() else {
+        return;
+    };
+    devices.focused = true; // the window is hidden; GTA has the user's focus
+    // console lines from GTA (also while MW2 mode is off: loadout changes)
+    // GTA resets the ring when it starts IW4L, so everything in it is for this process
+    // (they wait for the match: give / class need a live player)
+    let in_game = screen.is_some_and(|s| *s == frame::AppScreen::InGame);
+    let read = state.cmd_read.get_or_insert(0);
+    while in_game && *read != input.cmd_write {
+        if let Some(line) = gtalink::command(*read)
+            && !line.trim().is_empty()
+        {
+            diag::info!(Launch, "gtalink: {line}");
+            queue.push_line(&line);
+        }
+        *read = read.wrapping_add(1);
+    }
+    let on = input.mode == 1;
+    let prev = state.last.filter(|_| on);
+    if !on {
+        if state.last.is_some_and(|last| last.mode == 1) {
+            for (_, name) in HOLDS {
+                scripted.release(name);
+            }
+            for name in ["+forward", "+back", "+moveleft", "+moveright"] {
+                scripted.release(name);
+            }
+        }
+        state.last = Some(input);
+        return;
+    }
+    for (bit, name) in HOLDS {
+        if input.held(bit) {
+            scripted.hold(name);
+        } else {
+            scripted.release(name);
+        }
+    }
+    for (bit, name) in EDGES {
+        let was = prev.is_some_and(|p| p.held(bit));
+        if input.held(bit) && !was {
+            if name.starts_with('+') {
+                scripted.press(name, 0.1);
+            } else {
+                queue.push_line(name);
+            }
+        }
+    }
+    let [fwd, right] = input.move_;
+    for (on, name) in [
+        (fwd > 0.3, "+forward"),
+        (fwd < -0.3, "+back"),
+        (right > 0.3, "+moveright"),
+        (right < -0.3, "+moveleft"),
+    ] {
+        if on {
+            scripted.hold(name);
+        } else {
+            scripted.release(name);
+        }
+    }
+    if let Some(prev) = prev {
+        let dx = input.mouse[0].wrapping_sub(prev.mouse[0]);
+        let dy = input.mouse[1].wrapping_sub(prev.mouse[1]);
+        if dx != 0 || dy != 0 {
+            scripted.queue_mouse(dx as f32, dy as f32);
+        }
+    }
+    state.last = Some(input);
+}
