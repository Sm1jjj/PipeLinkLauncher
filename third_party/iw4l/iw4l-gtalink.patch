+/// GTA link: GTA traces every pellet against San Andreas and applies the damage.
+fn gtalink_shot(weapon: u32, dir: [f32; 3], facts: &weapon_iw4::WeaponCombatFacts, flags: u32) {
+    ::frame::gtalink::push_shot(::frame::gtalink::Shot {
+        weapon,
+        dir,
+        damage: facts.damage as f32,
+        min_damage: facts.min_damage as f32,
+        max_damage_range: facts.max_damage_range,
+        min_damage_range: facts.min_damage_range,
+        range: facts.bullet_range(),
+        flags,
+        ..Default::default()
+    });
+}
+
+/// Only the authority reports (prediction steps the same shot with its own aim), and only once.
+fn gtalink_first_sight(seed: u32, weapon: u32, pellet: u16) -> bool {
+    static SEEN: std::sync::Mutex<std::collections::VecDeque<(u32, u32, u16)>> =
+        std::sync::Mutex::new(std::collections::VecDeque::new());
+    let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+    let key = (seed, weapon, pellet);
+    if seen.contains(&key) {
+        return false;
+    }
+    if seen.len() >= 512 {
+        seen.pop_front();
+    }
+    seen.push_back(key);
+    true
+}
+
