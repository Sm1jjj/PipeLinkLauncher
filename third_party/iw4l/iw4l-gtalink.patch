diff --git a/crates/bootstrap/src/gtalink.rs b/crates/bootstrap/src/gtalink.rs
new file mode 100644
index 0000000..e5975ef
--- /dev/null
+++ b/crates/bootstrap/src/gtalink.rs
@@ -0,0 +1,131 @@
+//! GTA link (main world): publishes the presented first-person view to PipeLink, sizes the
+//! hidden window to GTA's viewport, takes GTA's FOV setting and paces the hidden renderer.
+//! The protocol is `frame::gtalink`; input is `console::gtalink`, frames `render_gpu`.
+
+use std::time::{Duration, Instant};
+
+use bevy::prelude::*;
+use frame::gtalink::{self, FLAG_ADS, FLAG_ALIVE, FLAG_CROUCH, FLAG_PRONE, FLAG_SPRINT};
+use playerstate_iw4::pm_flags;
+use render_scene::camera::{FlyCamera, FpvLens};
+
+/// Hidden renderer rate while MW2 mode is on (GTA SA itself runs at 30-60).
+const ACTIVE_FPS: f32 = 90.0;
+/// While GTA does not want frames: keep the match alive, spend nothing.
+const IDLE_FPS: f32 = 15.0;
+
+pub(crate) fn window() -> Window {
+    Window {
+        title: "iw4l — gtalink".into(),
+        resolution: (1280u32, 720u32).into(),
+        visible: false,
+        focused: true,
+        ..default()
+    }
+}
+
+pub(crate) fn install(app: &mut App) {
+    app.insert_resource(bevy::winit::WinitSettings::continuous())
+        .add_systems(First, pace)
+        .add_systems(Update, follow_gta_settings)
+        .add_systems(
+            PostUpdate,
+            publish_view.after(bevy::transform::TransformSystems::Propagate),
+        );
+}
+
+fn follow_gta_settings(mut settings: ResMut<frame::GameSettings>) {
+    let Some(input) = gtalink::read_input() else {
+        return;
+    };
+    let (w, h) = (input.width.min(gtalink::MAX_W), input.height.min(gtalink::MAX_H));
+    if w >= 64
+        && h >= 64
+        && (settings.resolution.width != w || settings.resolution.height != h || settings.fullscreen)
+    {
+        settings.resolution = frame::DisplayResolution { width: w, height: h };
+        settings.fullscreen = false;
+        settings.vsync = false;
+    }
+    if input.fov >= 65.0 && input.fov <= 120.0 && (settings.fov - input.fov).abs() > 0.01 {
+        settings.fov = input.fov;
+    }
+}
+
+fn pace(mut last: Local<Option<Instant>>) {
+    let fps = if gtalink::active() { ACTIVE_FPS } else { IDLE_FPS };
+    let budget = Duration::from_secs_f32(1.0 / fps);
+    if let Some(t) = *last {
+        let spent = t.elapsed();
+        if spent < budget {
+            std::thread::sleep(budget - spent);
+        }
+    }
+    *last = Some(Instant::now());
+}
+
+fn publish_view(
+    hosts: Query<&GlobalTransform, With<FlyCamera>>,
+    lenses: Query<&Projection, With<FpvLens>>,
+    presented: Res<net::PresentedSnapshot>,
+    prediction: Res<net::ClientPredictionState>,
+    local: Res<net::LocalPresentClient>,
+    weapons: Option<Res<assets::PreparedWeapons>>,
+    screen: Res<frame::AppScreen>,
+) {
+    let Ok(host) = hosts.single() else {
+        return;
+    };
+    let fov_y = lenses
+        .iter()
+        .find_map(|p| match p {
+            Projection::Perspective(p) => Some(p.fov.to_degrees()),
+            _ => None,
+        })
+        .unwrap_or(0.0);
+    // the predicted state is what the camera was built from: its origin makes a clean eye offset
+    // (the presented snapshot lags it, which pushed GTA's eye around with MW2's own collisions)
+    let ps = prediction.0.predicted_local().or_else(|| presented.player(local.0));
+    let (_, rotation, translation) = host.to_scale_rotation_translation();
+    // camera local: x right, y up, -z forward (render_scene::camera::transform_from_iw_view)
+    let fwd = rotation * Vec3::NEG_Z;
+    let up = rotation * Vec3::Y;
+    let name = ps
+        .zip(weapons.as_deref())
+        .map(|(ps, w)| w.0.name_of(ps.weapon).to_owned())
+        .unwrap_or_default();
+    gtalink::with_header(|h| {
+        h.cam_pos = translation.to_array();
+        h.cam_fwd = fwd.to_array();
+        h.cam_up = up.to_array();
+        h.fov_y = fov_y;
+        let mut flags = 0;
+        if let Some(ps) = ps {
+            if ps.health > 0 && *screen == frame::AppScreen::InGame {
+                flags |= FLAG_ALIVE;
+            }
+            if ps.f_weapon_pos_frac > 0.5 {
+                flags |= FLAG_ADS;
+            }
+            if ps.pm_flags & pm_flags::SPRINTING != 0 {
+                flags |= FLAG_SPRINT;
+            }
+            if ps.pm_flags & pm_flags::CROUCH != 0 {
+                flags |= FLAG_CROUCH;
+            }
+            if ps.pm_flags & pm_flags::PRONE != 0 {
+                flags |= FLAG_PRONE;
+            }
+            h.player_origin = ps.origin;
+            h.view_angles = ps.viewangles;
+            h.weapon = ps.weapon;
+        }
+        h.flags = flags;
+        h.ammo_clip = -1;
+        h.ammo_stock = -1;
+        let bytes = name.as_bytes();
+        let n = bytes.len().min(h.weapon_name.len() - 1);
+        h.weapon_name = [0; 64];
+        h.weapon_name[..n].copy_from_slice(&bytes[..n]);
+    });
+}
