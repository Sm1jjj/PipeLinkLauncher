+//! GTA link: copies every finished viewmodel frame (before the 2D HUD) into the shared
+//! `frame.bin` that PipeLink composites over San Andreas. See `frame::gtalink`.
+//!
+//! A full-screen pass packs colour + depth coverage into BGRA, the result is copied into one of
+//! three readback buffers, mapped after submit and handed to `frame::gtalink::publish_frame`
+//! from whichever later frame finds it mapped.
+//!
+//! A scoped sniper hides the gun and shows a 2D overlay (black frame, clear lens), which MW2 draws
+//! with the HUD, after this pass: `hud::GtaLinkScope` carries it here and the shader draws it into
+//! the exported frame.
+
+use std::num::NonZeroU64;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+use bevy::core_pipeline::{Core3d, Core3dSystems};
+use bevy::prelude::*;
+use bevy::render::RenderStartup;
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_resource::binding_types::{
+    sampler, texture_2d, texture_depth_2d, uniform_buffer_sized,
+};
+use bevy::render::render_resource::{
+    BufferInitDescriptor, Sampler, SamplerBindingType, SamplerDescriptor,
+};
+use bevy::render::texture::GpuImage;
+use bevy::render::{Extract, ExtractSchedule};
+use bevy::render::render_resource::{
+    BindGroupEntries, BindGroupLayoutDescriptor, BindGroupLayoutEntries, Buffer, BufferDescriptor,
+    BufferUsages, CachedRenderPipelineId, ColorTargetState, ColorWrites, Extent3d, FragmentState,
+    LoadOp, MapMode, Operations, PipelineCache, PrimitiveState, RenderPassColorAttachment,
+    RenderPassDescriptor, RenderPipelineDescriptor, ShaderStages, StoreOp, TexelCopyBufferInfo,
+    TexelCopyBufferLayout, Texture, TextureDescriptor, TextureDimension, TextureFormat,
+    TextureSampleType, TextureUsages, TextureView, TextureViewDescriptor, VertexState,
+};
+use bevy::render::renderer::{RenderContext, RenderDevice, ViewQuery};
+use bevy::render::view::ViewTarget;
+use bevy::render::{Render, RenderApp, RenderSystems};
+use bevy::shader::Shader;
+
+use super::scene_depth::{SCENE_DEPTH_ATTACHED, SceneDepthTexture};
+
+const SHADER_PATH: &str = "embedded://render_gpu/drawsurf/gtalink_export.wgsl";
+const RING: usize = 3;
+/// `Scope` in the shader: quads[4], flips, fill_rect, fill_rgba, params (alpha, n, has_depth, 0)
+const SCOPE_SIZE: u64 = 128;
+
+const IDLE: u8 = 0;
+const COPIED: u8 = 1;
+const MAPPING: u8 = 2;
+const MAPPED: u8 = 3;
+const FAILED: u8 = 4;
+
+struct Readback {
+    buffer: Buffer,
+    state: Arc<AtomicU8>,
+    width: u32,
+    height: u32,
+    pitch: u32,
+}
+
+#[derive(Resource)]
+struct GtaLinkExport {
+    shader: Handle<Shader>,
+    layout: BindGroupLayoutDescriptor,
+    pipeline: Option<CachedRenderPipelineId>,
+    target: Option<(Texture, TextureView, u32, u32)>,
+    no_overlay: TextureView,
+    sampler: Sampler,
+    ring: Vec<Option<Readback>>,
+    next: usize,
+}
+
+fn init(mut commands: Commands, asset_server: Res<AssetServer>, device: Res<RenderDevice>) {
+    let layout = BindGroupLayoutDescriptor::new(
+        "gtalink_export",
+        &BindGroupLayoutEntries::sequential(
+            ShaderStages::FRAGMENT,
+            (
+                texture_2d(TextureSampleType::Float { filterable: false }),
+                texture_depth_2d(),
+                uniform_buffer_sized(false, NonZeroU64::new(SCOPE_SIZE)),
+                texture_2d(TextureSampleType::Float { filterable: true }),
+                sampler(SamplerBindingType::Filtering),
+            ),
+        ),
+    );
+    // bound when there is no scope overlay (the shader never samples it then)
+    let no_overlay = device
+        .create_texture(&TextureDescriptor {
+            label: Some("gtalink_no_overlay"),
+            size: Extent3d {
+                width: 1,
+                height: 1,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: TextureDimension::D2,
+            format: TextureFormat::Rgba8Unorm,
+            usage: TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        })
+        .create_view(&TextureViewDescriptor::default());
+    commands.insert_resource(GtaLinkExport {
+        shader: asset_server.load(SHADER_PATH),
+        layout,
+        pipeline: None,
+        target: None,
+        no_overlay,
+        sampler: device.create_sampler(&SamplerDescriptor::default()),
+        ring: (0..RING).map(|_| None).collect(),
+        next: 0,
+    });
+}
+
+fn prepare(gpu: Option<ResMut<GtaLinkExport>>, cache: Res<PipelineCache>, device: Res<RenderDevice>) {
+    let Some(mut gpu) = gpu else {
+        return;
+    };
+    if gpu.pipeline.is_none() {
+        gpu.pipeline = Some(cache.queue_render_pipeline(RenderPipelineDescriptor {
+            label: Some("gtalink_export".into()),
+            layout: vec![gpu.layout.clone()],
+            immediate_size: 0,
+            vertex: VertexState {
+                shader: gpu.shader.clone(),
+                shader_defs: Vec::new(),
+                entry_point: Some("vs_main".into()),
+                buffers: Vec::new(),
+            },
+            fragment: Some(FragmentState {
+                shader: gpu.shader.clone(),
+                shader_defs: Vec::new(),
+                entry_point: Some("fs_main".into()),
+                targets: vec![Some(ColorTargetState {
+                    format: TextureFormat::Rgba8Unorm,
+                    blend: None,
+                    write_mask: ColorWrites::ALL,
+                })],
+            }),
+            primitive: PrimitiveState::default(),
+            depth_stencil: None,
+            multisample: default(),
+            zero_initialize_workgroup_memory: false,
+        }));
+    }
+    // hand finished readbacks to GTA
+    let _ = device.poll(bevy::render::render_resource::PollType::Poll);
+    for slot in gpu.ring.iter_mut() {
+        let Some(rb) = slot else {
+            continue;
+        };
+        match rb.state.load(Ordering::Acquire) {
+            MAPPED => {
+                {
+                    let view = rb.buffer.slice(..).get_mapped_range();
+                    frame::gtalink::publish_frame(rb.width, rb.height, &view, rb.pitch as usize);
+                }
+                rb.buffer.unmap();
+                rb.state.store(IDLE, Ordering::Release);
+            }
+            FAILED => *slot = None,
+            _ => {}
+        }
+    }
+}
+
+fn extract_scope(mut commands: Commands, scope: Extract<Option<Res<hud::GtaLinkScope>>>) {
+    commands.insert_resource(scope.as_deref().cloned().unwrap_or_default());
+}
+
+fn scope_bytes(scope: &hud::GtaLinkScope, has_overlay: bool, has_depth: bool) -> Vec<u8> {
+    let mut b = Vec::with_capacity(SCOPE_SIZE as usize);
+    for q in scope.quads {
+        for v in q {
+            b.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+    for v in scope.flips {
+        b.extend_from_slice(&v.to_le_bytes());
+    }
+    let params = [
+        if has_overlay { scope.alpha } else { 0.0 },
+        scope.n.min(4) as f32,
+        if has_depth { 1.0 } else { 0.0 },
+        0.0,
+    ];
+    for v in scope.fill_rect.into_iter().chain(scope.fill_rgba).chain(params) {
+        b.extend_from_slice(&v.to_le_bytes());
+    }
+    debug_assert_eq!(b.len() as u64, SCOPE_SIZE);
+    b
+}
+
+#[allow(clippy::too_many_arguments)]
+fn draw(
+    view: ViewQuery<(&ViewTarget, &SceneDepthTexture)>,
+    gpu: Option<ResMut<GtaLinkExport>>,
+    scope: Option<Res<hud::GtaLinkScope>>,
+    images: Res<RenderAssets<GpuImage>>,
+    cache: Res<PipelineCache>,
+    device: Res<RenderDevice>,
+    mut context: RenderContext,
+) {
+    let Some(mut gpu) = gpu else {
+        return;
+    };
+    let has_depth = SCENE_DEPTH_ATTACHED.swap(false, std::sync::atomic::Ordering::Relaxed);
+    if !frame::gtalink::active() {
+        return;
+    }
+    let Some(pipeline) = gpu.pipeline.and_then(|id| cache.get_render_pipeline(id)) else {
+        return;
+    };
+    let (target, depth) = view.into_inner();
+    let size = target.main_texture().size();
+    let (w, h) = (size.width, size.height);
+    if w == 0 || h == 0 || w > frame::gtalink::MAX_W || h > frame::gtalink::MAX_H {
+        return;
+    }
+    // a free readback buffer of the right size, else skip this frame
+    let index = (0..RING)
+        .map(|k| (gpu.next + k) % RING)
+        .find(|&i| match &gpu.ring[i] {
+            None => true,
+            Some(rb) => rb.state.load(Ordering::Acquire) == IDLE,
+        });
+    let Some(index) = index else {
+        return;
+    };
+    gpu.next = (index + 1) % RING;
+    let pitch = RenderDevice::align_copy_bytes_per_row(w as usize * 4) as u32;
+    if gpu.ring[index]
+        .as_ref()
+        .is_none_or(|rb| rb.width != w || rb.height != h)
+    {
+        gpu.ring[index] = Some(Readback {
+            buffer: device.create_buffer(&BufferDescriptor {
+                label: Some("gtalink_readback"),
+                size: u64::from(pitch) * u64::from(h),
+                usage: BufferUsages::MAP_READ | BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            }),
+            state: Arc::new(AtomicU8::new(IDLE)),
+            width: w,
+            height: h,
+            pitch,
+        });
+    }
+    if gpu.target.as_ref().is_none_or(|t| t.2 != w || t.3 != h) {
+        let texture = device.create_texture(&TextureDescriptor {
+            label: Some("gtalink_export"),
+            size: Extent3d {
+                width: w,
+                height: h,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: TextureDimension::D2,
+            format: TextureFormat::Rgba8Unorm,
+            usage: TextureUsages::RENDER_ATTACHMENT | TextureUsages::COPY_SRC,
+            view_formats: &[],
+        });
+        let view = texture.create_view(&TextureViewDescriptor::default());
+        gpu.target = Some((texture, view, w, h));
+    }
+    let Some((texture, out_view, _, _)) = gpu.target.as_ref() else {
+        return;
+    };
+    let scope = scope.as_deref().cloned().unwrap_or_default();
+    let overlay = scope
+        .image
+        .filter(|_| scope.alpha > 0.0)
+        .and_then(|id| images.get(id));
+    let uniform = device.create_buffer_with_data(&BufferInitDescriptor {
+        label: Some("gtalink_scope"),
+        contents: &scope_bytes(&scope, overlay.is_some(), has_depth),
+        usage: BufferUsages::UNIFORM,
+    });
+    let (overlay_view, overlay_sampler) = match overlay {
+        Some(image) => (&image.texture_view, &image.sampler),
+        None => (&gpu.no_overlay, &gpu.sampler),
+    };
+    let bind = device.create_bind_group(
+        Some("gtalink_export"),
+        &cache.get_bind_group_layout(&gpu.layout),
+        &BindGroupEntries::sequential((
+            target.main_texture_view(),
+            depth.view(),
+            uniform.as_entire_binding(),
+            overlay_view,
+            overlay_sampler,
+        )),
+    );
+    let encoder = context.command_encoder();
+    {
+        let mut pass = encoder.begin_render_pass(&RenderPassDescriptor {
+            label: Some("gtalink_export"),
+            color_attachments: &[Some(RenderPassColorAttachment {
+                view: out_view,
+                resolve_target: None,
+                ops: Operations {
+                    load: LoadOp::Clear(LinearRgba::NONE.into()),
+                    store: StoreOp::Store,
+                },
+                depth_slice: None,
+            })],
+            depth_stencil_attachment: None,
+            timestamp_writes: None,
+            occlusion_query_set: None,
+            multiview_mask: None,
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &bind, &[]);
+        pass.draw(0..3, 0..1);
+    }
+    let Some(rb) = gpu.ring[index].as_ref() else {
+        return;
+    };
+    encoder.copy_texture_to_buffer(
+        texture.as_image_copy(),
+        TexelCopyBufferInfo {
+            buffer: &rb.buffer,
+            layout: TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(pitch),
+                rows_per_image: Some(h),
+            },
+        },
+        Extent3d {
+            width: w,
+            height: h,
+            depth_or_array_layers: 1,
+        },
+    );
+    rb.state.store(COPIED, Ordering::Release);
+}
+
+// after the frame's submit: start mapping what was copied
+fn map_copied(gpu: Option<Res<GtaLinkExport>>) {
+    let Some(gpu) = gpu else {
+        return;
+    };
+    for rb in gpu.ring.iter().flatten() {
+        if rb
+            .state
+            .compare_exchange(COPIED, MAPPING, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            continue;
+        }
+        let state = rb.state.clone();
+        rb.buffer.slice(..).map_async(MapMode::Read, move |result| {
+            state.store(if result.is_ok() { MAPPED } else { FAILED }, Ordering::Release);
+        });
+    }
+}
+
+pub(super) fn register(app: &mut App) {
+    if !frame::gtalink::enabled() {
+        return;
+    }
+    bevy::asset::embedded_asset!(app, "gtalink_export.wgsl");
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        return;
+    };
+    render_app
+        .add_systems(RenderStartup, init)
+        .add_systems(ExtractSchedule, extract_scope)
+        .add_systems(Render, prepare.in_set(RenderSystems::Prepare))
+        .add_systems(Render, map_copied.in_set(RenderSystems::Cleanup))
+        .add_systems(
+            Core3d,
+            draw.in_set(Core3dSystems::PostProcess)
+                .after(super::postfx::PostFxSet)
+                .before(super::iw_tess::IwTessSet),
+        );
+}
diff --git a/crates/render_gpu/src/drawsurf/gtalink_export.wgsl b/crates/render_gpu/src/drawsurf/gtalink_export.wgsl
new file mode 100644
index 0000000..8c28216
--- /dev/null
+++ b/crates/render_gpu/src/drawsurf/gtalink_export.wgsl
@@ -0,0 +1,67 @@
+// GTA link export: the finished viewmodel layer as BGRA with premultiplied alpha.
+// Alpha is coverage from the scene depth (cleared to 0, reverse Z): the hands and gun are
+// opaque, the additive FX drawn over the black clear (muzzle flash, smoke) keep alpha 0 and
+// therefore add onto San Andreas exactly as they add onto MW2's own scene.
+// A scoped sniper's 2D overlay (drawn by MW2's HUD after this pass) is drawn over that here:
+// its clear lens stays alpha 0, so San Andreas shows through it.
+
+struct Scope {
+    quads: array<vec4<f32>, 4>,   // left, top, right, bottom (screen fractions)
+    flips: vec4<u32>,             // bit 0 flip s, bit 1 flip t
+    fill_rect: vec4<f32>,         // outside it: the letterbox, in fill_rgba
+    fill_rgba: vec4<f32>,
+    params: vec4<f32>,            // overlay alpha (0 = none), quad count, scene depth valid this frame
+}
+
+@group(0) @binding(0) var scene_tex: texture_2d<f32>;
+@group(0) @binding(1) var depth_tex: texture_depth_2d;
+@group(0) @binding(2) var<uniform> scope: Scope;
+@group(0) @binding(3) var overlay_tex: texture_2d<f32>;
+@group(0) @binding(4) var overlay_smp: sampler;
+
+struct Out {
+    @builtin(position) clip: vec4<f32>,
+}
+
+@vertex
+fn vs_main(@builtin(vertex_index) i: u32) -> Out {
+    let uv = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    var o: Out;
+    o.clip = vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0);
+    return o;
+}
+
+fn inside(p: vec2<f32>, r: vec4<f32>) -> bool {
+    return p.x >= r.x && p.x < r.z && p.y >= r.y && p.y < r.w;
+}
+
+@fragment
+fn fs_main(o: Out) -> @location(0) vec4<f32> {
+    let p = vec2<i32>(o.clip.xy);
+    let c = textureLoad(scene_tex, p, 0);
+    let z = textureLoad(depth_tex, p, 0);
+    // no pass attached the depth this frame (nothing drawn, e.g. the gun hidden at full ADS): it is stale
+    let a = select(0.0, 1.0, z > 0.0 && scope.params.z > 0.5);
+    var out = vec4<f32>(c.b, c.g, c.r, a);
+    let alpha = scope.params.x;
+    if alpha > 0.0 {
+        let f = o.clip.xy / vec2<f32>(textureDimensions(scene_tex));
+        var s = scope.fill_rgba;
+        if inside(f, scope.fill_rect) {
+            s = vec4<f32>(0.0);
+        }
+        let n = u32(scope.params.y);
+        for (var i = 0u; i < n; i++) {
+            let r = scope.quads[i];
+            if inside(f, r) {
+                var uv = (f - r.xy) / max(r.zw - r.xy, vec2<f32>(1e-6));
+                if (scope.flips[i] & 1u) != 0u { uv.x = 1.0 - uv.x; }
+                if (scope.flips[i] & 2u) != 0u { uv.y = 1.0 - uv.y; }
+                s = textureSampleLevel(overlay_tex, overlay_smp, uv, 0.0);
+            }
+        }
+        let sa = s.a * alpha;
+        out = vec4<f32>(s.b * sa, s.g * sa, s.r * sa, sa) + out * (1.0 - sa);
+    }
+    return out;
+}
