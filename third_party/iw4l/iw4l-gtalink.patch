@@ -0,0 +1,366 @@
+//! GTA link: IW4L as the first-person weapon layer of GTA San Andreas (PipeLink).
+//!
+//! On when `IW4L_GTALINK` names a folder holding (or receiving) `frame.bin` and
+//! `input.bin`. The layout is `common/mw2link.h` in the PipeLink tree; offsets
+//! below must stay in step with it. In this mode the renderer draws only the
+//! viewmodel and its FX, exports every frame, and the sim reports each pellet.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering, fence};
+use std::sync::{Mutex, OnceLock};
+
+pub const SLOTS: usize = 3;
+pub const MAX_W: u32 = 2560;
+pub const MAX_H: u32 = 1440;
+pub const HEADER: usize = 4096;
+pub const SLOT_BYTES: usize = 4 * MAX_W as usize * MAX_H as usize;
+pub const INPUT_BYTES: usize = 65536;
+pub const SHOTS: usize = 64;
+pub const CMDS: usize = 32;
+pub const CMD_LEN: usize = 256;
+pub const KILLS: usize = 32;
+const FRAME_MAGIC: u32 = 0x3257_4C47;
+const INPUT_MAGIC: u32 = 0x4957_4C47;
+const VERSION: u32 = 1;
+
+pub const FLAG_ALIVE: u32 = 1;
+pub const FLAG_ADS: u32 = 2;
+pub const FLAG_SPRINT: u32 = 4;
+pub const FLAG_CROUCH: u32 = 8;
+pub const FLAG_PRONE: u32 = 16;
+pub const SHOT_PROJECTILE: u32 = 1;
+
+pub mod button {
+    pub const ATTACK: u32 = 0;
+    pub const ADS: u32 = 1;
+    pub const RELOAD: u32 = 2;
+    pub const SPRINT: u32 = 3;
+    pub const MELEE: u32 = 4;
+    pub const JUMP: u32 = 5;
+    pub const CROUCH: u32 = 6;
+    pub const PRONE: u32 = 7;
+    pub const USE: u32 = 8;
+    pub const FRAG: u32 = 9;
+    pub const SMOKE: u32 = 10;
+    pub const WEAPNEXT: u32 = 11;
+    pub const SLOT1: u32 = 12;
+    pub const SLOT2: u32 = 13;
+    pub const SLOT3: u32 = 14;
+    pub const SLOT4: u32 = 15;
+    pub const HOLDBREATH: u32 = 16;
+    pub const COUNT: u32 = 17;
+}
+
+#[repr(C, packed(4))]
+#[derive(Clone, Copy, Default)]
+pub struct Shot {
+    pub seq: u32,
+    pub weapon: u32,
+    pub dir: [f32; 3],
+    pub damage: f32,
+    pub min_damage: f32,
+    pub max_damage_range: f32,
+    pub min_damage_range: f32,
+    pub range: f32,
+    pub flags: u32,
+}
+
+#[repr(C, packed(4))]
+pub struct FrameHeader {
+    pub magic: u32,
+    pub version: u32,
+    pub seq: u32,
+    pub slot: u32,
+    pub width: u32,
+    pub height: u32,
+    pub flags: u32,
+    pub frame_no: u32,
+    pub cam_pos: [f32; 3],
+    pub cam_fwd: [f32; 3],
+    pub cam_up: [f32; 3],
+    pub player_origin: [f32; 3],
+    pub fov_y: f32,
+    pub view_angles: [f32; 3],
+    pub ammo_clip: i32,
+    pub ammo_stock: i32,
+    pub weapon: u32,
+    pub weapon_name: [u8; 64],
+    pub shot_write: u32,
+    pub shots: [Shot; SHOTS],
+    pub score: u32,
+    pub kills: u32,
+    pad: [u8; 3072 - 3000],
+    pub slot_gen: [u32; SLOTS],
+}
+
+#[repr(C, packed(4))]
+#[derive(Clone, Copy)]
+pub struct Kill {
+    pub points: i32,
+    pub flags: u32,
+}
+
+#[repr(C, packed(4))]
+pub struct InputHeader {
+    pub magic: u32,
+    pub mode: u32,
+    pub width: u32,
+    pub height: u32,
+    pub gta_frame: u32,
+    pub buttons: u32,
+    pub move_: [f32; 2],
+    pub mouse_x: i32,
+    pub mouse_y: i32,
+    pub fov: f32,
+    pub reading: u32,
+    pub cmd_write: u32,
+    pub kill_write: u32,
+    pub surface: u32,
+    pad: [u8; 64 - 60],
+    pub cmds: [[u8; CMD_LEN]; CMDS],
+    pub kills: [Kill; KILLS],
+}
+
+const _: () = assert!(core::mem::size_of::<Shot>() == 44);
+const _: () = assert!(core::mem::offset_of!(FrameHeader, shots) == 176);
+const _: () = assert!(core::mem::offset_of!(FrameHeader, score) == 2992);
+const _: () = assert!(core::mem::offset_of!(FrameHeader, slot_gen) == 3072);
+const _: () = assert!(core::mem::size_of::<FrameHeader>() <= HEADER);
+const _: () = assert!(core::mem::offset_of!(InputHeader, surface) == 56);
+const _: () = assert!(core::mem::offset_of!(InputHeader, cmds) == 64);
+const _: () = assert!(core::mem::offset_of!(InputHeader, kills) == 8256);
+
+struct Link {
+    frame: *mut u8,
+    input: *mut u8,
+    header: Mutex<()>,
+}
+
+// SAFETY: the two mappings live for the whole process; header writes are serialised by
+// `header`, slot writes are owned by the single render-thread exporter.
+unsafe impl Send for Link {}
+unsafe impl Sync for Link {}
+
+static LINK: OnceLock<Option<Link>> = OnceLock::new();
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+/// MW2 surface type + 1 under CJ's feet (0 = none): the local player's footsteps / landings use it.
+static SURFACE: AtomicU32 = AtomicU32::new(0);
+static FRAME_NO: AtomicU32 = AtomicU32::new(0);
+
+fn map(path: &std::path::Path, size: usize) -> std::io::Result<*mut u8> {
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(path)?;
+    if file.metadata()?.len() < size as u64 {
+        file.set_len(size as u64)?;
+    }
+    // SAFETY: the file is shared with GTA on purpose; both sides follow the seq protocol.
+    let map = unsafe { memmap2::MmapOptions::new().len(size).map_mut(&file)? };
+    Ok(Box::leak(Box::new(map)).as_mut_ptr())
+}
+
+fn open() -> Option<Link> {
+    let dir = std::env::var_os("IW4L_GTALINK")?;
+    let dir = std::path::PathBuf::from(dir);
+    let _ = std::fs::create_dir_all(&dir);
+    let frame = map(&dir.join("frame.bin"), HEADER + SLOTS * SLOT_BYTES);
+    let input = map(&dir.join("input.bin"), INPUT_BYTES);
+    match (frame, input) {
+        (Ok(frame), Ok(input)) => {
+            let link = Link {
+                frame,
+                input,
+                header: Mutex::new(()),
+            };
+            // SAFETY: freshly mapped, at least HEADER bytes.
+            unsafe {
+                let h = &mut *(frame as *mut FrameHeader);
+                h.magic = FRAME_MAGIC;
+                h.version = VERSION;
+                h.seq = 0;
+                h.frame_no = 0;
+                h.shot_write = 0;
+                let i = &mut *(input as *mut InputHeader);
+                if i.magic != INPUT_MAGIC {
+                    std::ptr::write_bytes(input, 0, INPUT_BYTES);
+                    i.magic = INPUT_MAGIC;
+                }
+            }
+            Some(link)
+        }
+        (frame, input) => {
+            eprintln!(
+                "gtalink: cannot map {}: {:?} {:?}",
+                dir.display(),
+                frame.err(),
+                input.err()
+            );
+            None
+        }
+    }
+}
+
+fn link() -> Option<&'static Link> {
+    LINK.get_or_init(open).as_ref()
+}
+
+/// The process runs as GTA's weapon layer.
+pub fn enabled() -> bool {
+    link().is_some()
+}
+
+/// MW2's map ambience, emitters and music under GTA: off (San Andreas has its own). Under GTA only the
+/// weapon sounds (fire, reload, handling) and footsteps / landings play; see `mutes_other_sounds`.
+pub fn ambient_scale() -> f32 {
+    if enabled() { 0.0 } else { 1.0 }
+}
+
+/// Under GTA every other MW2 sound (announcer, impacts, explosions in the hidden map, breath, tinnitus, ...)
+/// is dropped.
+pub fn mutes_other_sounds() -> bool {
+    enabled()
+}
+
+/// The surface GTA reports under CJ, as IW4 surface flags (type << 20), while MW2 mode is on.
+pub fn surface_override() -> Option<u32> {
+    let s = SURFACE.load(Ordering::Relaxed);
+    (active() && s != 0).then(|| (s - 1) << 20)
+}
+
+/// GTA currently wants frames (MW2 mode on). Updated by `read_input`.
+pub fn active() -> bool {
+    ACTIVE.load(Ordering::Relaxed)
+}
+
+/// A copy of GTA's input header; also refreshes `active()`.
+pub fn read_input() -> Option<InputSnapshot> {
+    let link = link()?;
+    fence(Ordering::Acquire);
+    // SAFETY: mapped for the process lifetime; GTA writes it concurrently, torn values are tolerated.
+    let i = unsafe { &*(link.input as *const InputHeader) };
+    let snap = InputSnapshot {
+        mode: i.mode,
+        width: i.width,
+        height: i.height,
+        gta_frame: i.gta_frame,
+        buttons: i.buttons,
+        move_: i.move_,
+        mouse: [i.mouse_x, i.mouse_y],
+        fov: i.fov,
+        cmd_write: i.cmd_write,
+        kill_write: i.kill_write,
+    };
+    ACTIVE.store(snap.mode == 1, Ordering::Relaxed);
+    SURFACE.store(i.surface, Ordering::Relaxed);
+    Some(snap)
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct InputSnapshot {
+    pub mode: u32,
+    pub width: u32,
+    pub height: u32,
+    pub gta_frame: u32,
+    pub buttons: u32,
+    pub move_: [f32; 2],
+    pub mouse: [i32; 2],
+    pub fov: f32,
+    pub cmd_write: u32,
+    pub kill_write: u32,
+}
+
+impl InputSnapshot {
+    pub fn held(&self, button: u32) -> bool {
+        self.buttons & (1 << button) != 0
+    }
+}
+
+/// Console line number `n` (ring position n % CMDS).
+pub fn command(n: u32) -> Option<String> {
+    let link = link()?;
+    // SAFETY: see read_input.
+    let i = unsafe { &*(link.input as *const InputHeader) };
+    let raw = &i.cmds[n as usize % CMDS];
+    let end = raw.iter().position(|&b| b == 0).unwrap_or(CMD_LEN);
+    Some(String::from_utf8_lossy(&raw[..end]).into_owned())
+}
+
+pub fn kill(n: u32) -> Option<Kill> {
+    let link = link()?;
+    // SAFETY: see read_input.
+    let i = unsafe { &*(link.input as *const InputHeader) };
+    Some(i.kills[n as usize % KILLS])
+}
+
+/// The slot GTA is copying right now (never overwrite it).
+pub fn gta_reading_slot() -> Option<usize> {
+    let link = link()?;
+    // SAFETY: see read_input.
+    let r = unsafe { (*(link.input as *const InputHeader)).reading };
+    (r > 0).then(|| (r - 1) as usize)
+}
+
+/// Writes header fields under the seq protocol.
+pub fn with_header(f: impl FnOnce(&mut FrameHeader)) {
+    let Some(link) = link() else {
+        return;
+    };
+    let _guard = link.header.lock().unwrap_or_else(|e| e.into_inner());
+    // SAFETY: header access is serialised by the guard; GTA only reads.
+    let h = unsafe { &mut *(link.frame as *mut FrameHeader) };
+    h.seq = h.seq.wrapping_add(1) | 1;
+    fence(Ordering::Release);
+    f(h);
+    fence(Ordering::Release);
+    h.seq = h.seq.wrapping_add(1);
+}
+
+/// Queues one pellet for GTA.
+pub fn push_shot(mut shot: Shot) {
+    with_header(|h| {
+        let n = h.shot_write;
+        shot.seq = n.wrapping_add(1);
+        h.shots[n as usize % SHOTS] = shot;
+        h.shot_write = n.wrapping_add(1);
+    });
+}
+
+/// The render-thread exporter: copies one finished frame (BGRA, premultiplied, top-down rows,
+/// `row_pitch` bytes per source row) into a free slot and publishes it.
+pub fn publish_frame(width: u32, height: u32, src: &[u8], row_pitch: usize) {
+    let Some(link) = link() else {
+        return;
+    };
+    if width == 0 || height == 0 || width > MAX_W || height > MAX_H {
+        return;
+    }
+    // SAFETY: header is HEADER bytes; slots follow it.
+    let h = unsafe { &mut *(link.frame as *mut FrameHeader) };
+    let latest = h.slot as usize % SLOTS;
+    let busy = gta_reading_slot();
+    let Some(slot) = (0..SLOTS).find(|&s| s != latest && Some(s) != busy) else {
+        return;
+    };
+    let slot_gen = &mut h.slot_gen[slot] as *mut u32;
+    // SAFETY: slot index < SLOTS, each SLOT_BYTES long.
+    unsafe {
+        slot_gen.write_volatile(slot_gen.read_volatile().wrapping_add(1) | 1);
+        fence(Ordering::Release);
+        let dst = link.frame.add(HEADER + slot * SLOT_BYTES);
+        let row = width as usize * 4;
+        for y in 0..height as usize {
+            std::ptr::copy_nonoverlapping(src.as_ptr().add(y * row_pitch), dst.add(y * row), row);
+        }
+        fence(Ordering::Release);
+        slot_gen.write_volatile(slot_gen.read_volatile().wrapping_add(1));
+    }
+    let n = FRAME_NO.fetch_add(1, Ordering::Relaxed) + 1;
+    with_header(|h| {
+        h.slot = slot as u32;
+        h.width = width;
+        h.height = height;
+        h.frame_no = n;
+    });
+}
